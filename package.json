{
  "name": "@perceptionmanager/design-system",
  "version": "0.6.1",
  "description": "Shared design tokens, components and page shell for perceptionmanager.com, Role Analyzer, UX Intelligence Engine and Kiro UX Auditor.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./shell.css": "./dist/shell.css",
    "./shell.js": "./dist/shell.js",
    "./icons.svg": "./dist/icons.svg",
    "./logos.svg": "./dist/logos.svg",
    "./legacy-aliases.css": "./dist/legacy-aliases.css",
    "./tokens.json": "./dist/tokens.resolved.json"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "check": "npm run build && git diff --exit-code -- dist",
    "storybook": "npm run build && storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/html-vite": "^10.6.2",
    "storybook": "^10.6.2"
  }
}
