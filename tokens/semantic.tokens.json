      },
      "scrim-strong": {
        "$value": "{color.alpha.neutral-950-a97}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.50}"
      },
      "secondary": {
        "$value": "{color.neutral.400}"
      },
      "tertiary": {
        "$value": "{color.neutral.500}",
        "$description": "Was #7A8290 (4.0:1 on cards — fails AA). Lifted to #8B93A1 (5.0:1 on cards)."
      },
      "on-accent": {
        "$value": "{color.neutral.950}"
      },
      "accent": {
        "$value": "{color.coral.500}"
      },
      "interactive-hover": {
        "$value": "{color.cyan.400}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.alpha.white-a10}"
      },
      "strong": {
        "$value": "{color.alpha.white-a24}"
      },
      "accent": {
        "$value": "{color.alpha.coral-a35}"
      },
      "interactive-hover": {
        "$value": "{color.cyan.400}"
      }
    },
    "accent": {
      "primary": {
        "$value": "{color.coral.500}"
      },
      "secondary": {
        "$value": "{color.cyan.400}"
      },
      "primary-subtle": {
        "$value": "{color.alpha.coral-a12}"
      },
      "primary-muted": {
        "$value": "{color.alpha.coral-a24}"
      },
      "secondary-subtle": {
        "$value": "{color.alpha.cyan-a12}"
      }
    },
    "status": {
      "success": {
        "$value": "{color.green.400}",
        "$description": "Positive status (live dot, success messages)."
      },
      "critical": {
        "$value": "{color.rose.400}",
        "$description": "Severity: critical. Text/icon color; pair with -subtle background and -border."
      },
      "critical-subtle": {
        "$value": "{color.alpha.rose-a12}"
      },
      "critical-border": {
        "$value": "{color.alpha.rose-a35}"
      },
      "high": {
        "$value": "{color.orange.400}",
        "$description": "Severity: high."
      },
      "high-subtle": {
        "$value": "{color.alpha.orange-a12}"
      },
      "high-border": {
        "$value": "{color.alpha.orange-a35}"
      },
      "medium": {
        "$value": "{color.amber.300}",
        "$description": "Severity: medium."
      },
      "medium-subtle": {
        "$value": "{color.alpha.amber-a12}"
      },
      "medium-border": {
        "$value": "{color.alpha.amber-a35}"
      },
      "low": {
        "$value": "{color.neutral.400}",
        "$description": "Severity: low."
      },
      "low-subtle": {
        "$value": "{color.alpha.white-a6}"
      },
      "low-border": {
        "$value": "{color.alpha.white-a10}"
      },
      "error": {
        "$value": "{color.rose.400}",
        "$description": "Error messages and destructive states. Same hue as critical."
      },
      "error-subtle": {
        "$value": "{color.alpha.rose-a12}"
      },
      "error-border": {
        "$value": "{color.alpha.rose-a35}"
      },
      "warning": {
        "$value": "{color.amber.300}",
        "$description": "Warning messages. Same hue as medium."
      },
      "warning-subtle": {
        "$value": "{color.alpha.amber-a12}"
      },
      "warning-border": {
        "$value": "{color.alpha.amber-a35}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.cyan.400}"
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": {
      "$value": [
        {
          "color": "{color.coral.500}",
          "position": 0
        },
        {
          "color": "{color.coral.300}",
          "position": 0.35
        },
        {
          "color": "{color.cyan.400}",
          "position": 1
        }
      ],
      "$extensions": {
        "com.perceptionmanager.css": {
          "angle": "100deg"
        }
      }
    }
  },
  "typography": {
    "$type": "typography",
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.12}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": {
          "value": 0.0375,
          "unit": "rem"
        },
        "lineHeight": "{font.line-height.normal}"
      },
      "$extensions": {
        "com.perceptionmanager.fluid": {
          "min": {
            "value": 0.75,
            "unit": "rem"
          },
          "max": {
            "value": 0.75,
            "unit": "rem"
          },
          "viewport": {
            "min": 375,
            "max": 1280
          }
        },
        "com.perceptionmanager.css": {
          "tracking": "{font.tracking.caps}",
          "textTransform": "uppercase"
        }
      },
      "$description": "0.05em at 12px = 0.0375rem. CSS output uses the em token so tracking scales with size."
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.sans}",
