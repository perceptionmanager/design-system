  "motion": {
    "$type": "transition",
    "hover": {
      "$value": {
        "duration": "{duration.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.standard}"
      }
    },
    "state": {
      "$value": {
        "duration": "{duration.base}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.standard}"
      }
    },
    "enter": {
      "$value": {
        "duration": "{duration.entrance}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.emphasized}"
      }
    }
