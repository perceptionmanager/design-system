{
  "$description": "Tier 3 — component tokens. Shared components across portfolio, Role Analyzer, UX Intelligence Engine and Kiro UX Auditor reports.",
  "button": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.8}"
    },
    "tertiary-padding-y": {
      "$type": "dimension",
      "$value": "{space.2}",
      "$description": "Tertiary (text-only) button. Set in Figma 2026-10-07: 8px all sides (was 8px 2px in portfolio CSS)."
    },
    "tertiary-padding-x": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{layout.target-min}"
    },
    "primary-bg": {
      "$type": "gradient",
      "$value": "{gradient.brand}"
    },
    "primary-text": {
      "$type": "color",
      "$value": "{color.text.on-accent}"
    },
    "primary-shadow": {
      "$type": "shadow",
      "$value": "{shadow.glow-accent}"
    },
    "primary-shadow-hover": {
      "$type": "shadow",
      "$value": "{shadow.glow-accent-hover}"
    },
    "ghost-border": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "ghost-border-hover": {
      "$type": "color",
      "$value": "{color.border.interactive-hover}"
    }
  },
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.card}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    }
  },
  "tag": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.page}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.tertiary}"
    }
  },
  "stat": {
    "value-typography": {
      "$type": "typography",
      "$value": "{typography.heading-md}"
    },
    "label-color": {
      "$type": "color",
      "$value": "{color.text.tertiary}"
    }
  },
  "step": {
    "num-size": {
      "$type": "dimension",
      "$value": "{space.12}"
    },
    "line-color": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    }
  },
  "check": {
    "size": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "bg": {
      "$type": "color",
      "$value": "{color.accent.primary}"
    }
  },
  "nav": {
    "height": {
      "$type": "dimension",
      "$value": "{layout.nav-height}"
    },
    "link-color": {
      "$type": "color",
      "$value": "{color.text.secondary}"
    },
    "link-hover": {
      "$type": "color",
      "$value": "{color.text.primary}"
    }
  },
  "focus": {
    "ring-width": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "ring-offset": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "field": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "bg-code": {
      "$type": "color",
      "$value": "{color.surface.sunken}",
      "$description": "Multiline fields that take pasted code or long text."
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.control}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{color.border.interactive-hover}"
    },
    "border-invalid": {
      "$type": "color",
      "$value": "{color.status.error}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.tertiary}"
    },
    "label": {
      "$type": "color",
      "$value": "{color.text.secondary}"
    },
    "help": {
      "$type": "color",
      "$value": "{color.text.tertiary}"
    },
    "error": {
      "$type": "color",
      "$value": "{color.status.error}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{layout.target-min}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "multiline-padding": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}",
      "$description": "Space between label, control and helper or error text."
    }
  },
  "control": {
    "size": {
      "$type": "dimension",
      "$value": "{space.5}",
      "$description": "Checkbox and radio box (20px); the label extends the hit area to the 44px target."
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.control}"
    },
    "checked-bg": {
      "$type": "color",
      "$value": "{color.text.accent-secondary}",
      "$description": "Deep cyan in the light theme, so the checked box stays 3:1 on light surfaces."
    },
    "checked-mark": {
      "$type": "color",
      "$value": "{color.surface.page}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.xs}"
    }
  },
  "meter": {
    "height": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "track": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    }
  },
  "spinner": {
    "size": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "track": {
      "$type": "color",
      "$value": "{color.border.subtle}"
    },
    "indicator": {
      "$type": "color",
      "$value": "{color.text.accent-secondary}"
    }
  }
}
